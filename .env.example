# Copy to .env and fill in real values. .env is git-ignored; this file is
# tracked and committed.
#
# Keep every entry a placeholder. Never commit a real, plausible, or generated
# value here.
#
# EXAMPLE_API_KEY=

# --- PCR data store --------------------------------------------------------
# SQLAlchemy URL for the PCR/approval/audit data (separate from Django's own
# sqlite3 database -- see CLAUDE.md, "Two separate databases"). SQL Server is
# the target production backend, but a permissions issue currently blocks
# local access to it, so pick one of the two local alternatives below instead.

# Company laptop (default): a local SQLite file, git-ignored (*.sqlite3).
PCR_DATABASE_URL=sqlite:///pcr_dev.sqlite3

# Personal machine: Postgres via `uv run poe pg:up` (docker compose, see
# compose.yaml). Uncomment PCR_DATABASE_URL below and fill in the matching
# PCR_POSTGRES_* values that compose.yaml reads to create the container.
# PCR_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>
# PCR_POSTGRES_USER=
# PCR_POSTGRES_PASSWORD=
# PCR_POSTGRES_DB=

# --- Optional app settings --------------------------------------------------
# PCR_DEFAULT_ACTOR=
# PCR_DEBUG=true
# PCR_DJANGO_SECRET_KEY=
# PCR_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
